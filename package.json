{
  "name": "fleetip",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @fleetip/api run dev",
    "dev:web": "pnpm --filter @fleetip/web run dev",
    "setup": "pnpm install && pnpm run dev",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "migrate": "pnpm --filter @fleetip/api run migrate",
    "migrate:down": "pnpm --filter @fleetip/api run migrate:down"
  },
  "devDependencies": {
    "@10kdevs/matha": "^1.3.0",
    "eslint": "^9.18.0",
    "kysely": "^0.27.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
