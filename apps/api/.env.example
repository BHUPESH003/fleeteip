NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fleetip:fleetip@localhost:5433/fleetip
SESSION_COOKIE_SECRET=change-me-to-a-random-string-at-least-32-chars-long
SESSION_COOKIE_NAME=fleetip_session
WEB_ORIGIN=http://localhost:3000

# Email: "log" only logs messages (verification stays off). For real sending set
# MAIL_PROVIDER=resend plus RESEND_API_KEY and a MAIL_FROM on a domain verified in Resend.
MAIL_PROVIDER=log
MAIL_FROM=FleetIP <no-reply@example.com>
# RESEND_API_KEY=
